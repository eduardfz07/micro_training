SET(CMAKE_SYSTEM_NAME RTIME_MICROSAR_PI)

SET(COMPILER_PATH "/usr/bin" CACHE INTERNAL "COMPILER_PATH" FORCE)

IF (${TARGET_HELP})
    MESSAGE("TARGET\n\n i86leElfgcc13.3.0\n")
    MESSAGE("DESCRIPTION\n")
    MESSAGE(" This 32-bit Linux GCC PIL target can be used with AUTOSAR")
    MESSAGE(" targets. GCC 13.3.0 with multilib support is required.")
    MESSAGE("\nAvailable PSLs for this PIL")
    MESSAGE(" --name i86leElfgcc13.3.0-MICROSAR4\n")
    RETURN()
ENDIF()

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/Compiler/gcc_pi.tc)

INCLUDE_GCC_COMPILER_PIL("13.3.0" "-m32")
SET(CMAKE_C_COMPILER "${COMPILER_PATH}/gcc-13")
SET(CMAKE_CXX_COMPILER "${COMPILER_PATH}/g++-13")

SET(RTIME_EXCLUDE_NETIO_ZCOPY TRUE)

SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)